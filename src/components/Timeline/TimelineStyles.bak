export const TimelineContainer = styled.div`
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 20px;
  position: relative;
`;

export const TimelineItem = styled.div`
  display: flex;
  flex-direction: row;
  align-items: center;
  position: relative;
  margin-bottom: 20px;
`;

export const DateLabel = styled.div`
  width: 80px;
  font-weight: bold;
  text-align: right;
  margin-right: 20px;
  writing-mode: vertical-rl;
  transform: rotate(-90deg);
`;

export const EventContainer = styled.div`
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
`;

export const EventBar = styled.div<{ length: number; color: string }>`
  width: 10px;
  height: ${(props) => props.length}px;
  background-color: ${(props) => props.color};
  position: relative;
  border-radius: 5px;
`;

export const Tooltip = styled.div`
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  background-color: #333;
  color: white;
  padding: 5px 10px;
  border-radius: 5px;
  font-size: 12px;
  white-space: nowrap;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.2s ease-in-out;

  ${EventBar}:hover & {
    visibility: visible;
    opacity: 1;
  }
`;
